{
  "name": "doctor-booking-monorepo",
  "version": "1.0.0",
  "description": "Doctor booking application with component library workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,json,css,scss}\"",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "storybook": "turbo run storybook --filter=necktie-ui",
    "build-storybook": "turbo run build-storybook --filter=necktie-ui",
    "doctor-booking:dev": "turbo run dev --filter=doctor-booking",
    "doctor-booking:build": "turbo run build --filter=doctor-booking",
    "doctor-booking:start": "turbo run start --filter=doctor-booking",
    "prepare": "husky install"
  },
  "keywords": [
    "doctor-booking",
    "nextjs",
    "react",
    "monorepo",
    "component-library"
  ],
  "author": "Rinkesh Golwala",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
